<script>
(function () {
  var btn = document.getElementById('copy-mail');
  var src = document.getElementById('mail');
  var status = document.getElementById('copy-status');
  if (!btn || !src || !status) return;
  var timer;
  function say(text, label) {
    status.textContent = text;
    btn.textContent = label;
    clearTimeout(timer);
    timer = setTimeout(function () { status.textContent = ''; btn.textContent = 'Скопировать'; }, 2500);
  }
  function fallback() {
    try {
      var range = document.createRange();
      range.selectNodeContents(src);
      var sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
    } catch (e) {}
    say('Адрес выделен, нажмите Ctrl+C', 'Скопировать');
  }
  btn.addEventListener('click', function () {
    var text = src.textContent.trim();
    try {
      navigator.clipboard.writeText(text).then(function () {
        say('Адрес скопирован', 'Скопировано');
      }, fallback);
    } catch (e) {
      fallback();
    }
  });
})();
</script>

